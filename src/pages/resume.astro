---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site, links } from '../data/site';
import { summary, experience, skills, education } from '../data/resume';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const host = (href: string) => href.replace(/^https?:\/\//, '');
---
<Base title="Résumé" description={`Résumé of ${site.name}, ${site.title} in ${site.location}.`}>
  <article class="sheet grid">
    <header class="head">
      <h1>{site.name}</h1>
      <p class="sub">{site.title} · {site.location}</p>
      <ul class="contact" role="list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="https://ajheflin.com">ajheflin.com</a></li>
        {links.map((l) => <li><a href={l.href}>{host(l.href)}</a></li>)}
      </ul>
      <button class="print btn" type="button" id="print">Print or save as PDF <Arrow dir="down" /></button>
    </header>

    <p class="summary">{summary}</p>

    <section class="block" aria-labelledby="r-exp">
      <h2 id="r-exp" class="label">Experience</h2>
      <div class="entries">
        {experience.map((r) => (
          <div class="entry">
            <div class="entry-head">
              <h3>{r.role}, {r.company}</h3>
              <p class="when">{r.start} – {r.end}</p>
            </div>
            <p class="meta">{[r.team, r.location].filter(Boolean).join(' · ')}</p>
            <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-proj">
      <h2 id="r-proj" class="label">Projects</h2>
      <div class="entries">
        {work.map((p) => (
          <div class="entry">
            <div class="entry-head">
              <h3><a href={`/work/${p.id}`}>{p.data.title}</a></h3>
              <p class="when">{p.data.when}</p>
            </div>
            <p class="meta">{p.data.context} · {p.data.stack.join(', ')}</p>
            <p>{p.data.summary}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="r-skills">
      <h2 id="r-skills" class="label">Skills</h2>
      <dl class="entries skills">
        {Object.entries(skills).map(([group, items]) => (
          <div>
            <dt>{group}</dt>
            <dd>{items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="block" aria-labelledby="r-edu">
      <h2 id="r-edu" class="label">Education</h2>
      <div class="entries">
        <div class="entry-head">
          <h3>{education.degree}, {education.school}</h3>
          <p class="when">{education.years}</p>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .sheet {
    padding-top: var(--space-l);
    padding-bottom: var(--space-xl);
    row-gap: var(--space-l);
  }

  .head {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.6rem, 1rem + 6vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .sub {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    padding: 0;
    font-weight: 600;
  }

  .btn {
    margin-top: var(--space-s);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.75em 1.1em;
    font: inherit;
    font-weight: 750;
    background: var(--accent);
    color: var(--accent-ink);
    border: 2px solid var(--accent);
    cursor: pointer;
    transition: background-color 250ms var(--ease-out);
  }

  .btn:hover {
    background: var(--ink);
    border-color: var(--ink);
  }

  .summary {
    grid-column: 1 / 10;
    font-size: var(--step-1);
    line-height: 1.35;
    font-weight: 500;
    max-width: 52ch;
  }

  .block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 2px solid var(--ink);
    padding-top: var(--space-m);
  }

  .block > h2 {
    grid-column: 1 / 3;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .entries {
    grid-column: 3 / -1;
    display: grid;
    gap: var(--space-l);
    max-width: 72ch;
  }

  .entry {
    display: grid;
    gap: 0.4rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
  }

  h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .when,
  .meta {
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .entry ul {
    padding-left: 1.1em;
    display: grid;
    gap: 0.35rem;
    margin-top: 0.3rem;
  }

  .entry li::marker {
    color: var(--accent);
  }

  .skills {
    gap: var(--space-m);
  }

  .skills dt {
    font-weight: 750;
  }

  @media (max-width: 60rem) {
    .summary,
    .block > h2,
    .entries {
      grid-column: 1 / -1;
    }

    .block > h2 {
      margin-bottom: var(--space-m);
    }
  }

  @media print {
    :global(.nav),
    :global(.skip),
    .btn {
      display: none !important;
    }

    :global(body) {
      background: #fff;
      font-size: 9.5pt;
      line-height: 1.4;
    }

    @page {
      margin: 12mm 14mm;
    }

    .sheet {
      padding: 0;
      row-gap: 10pt;
      --margin: 0;
    }

    h1 {
      font-size: 26pt;
    }

    .sub,
    .summary,
    h3 {
      font-size: 11pt;
    }

    .entries {
      gap: 9pt;
      max-width: none;
    }

    .block {
      padding-top: 6pt;
      border-top-width: 1.5pt;
    }

    .entry {
      break-inside: avoid;
    }

    a {
      text-decoration: none;
    }
  }
</style>
