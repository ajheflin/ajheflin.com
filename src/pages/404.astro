---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Not found">
  <section class="grid lost">
    <h1>Not<br />here.</h1>
    <p>That page doesn't exist, or it moved.</p>
    <a href="/">Back to the home page <Arrow /></a>
  </section>
</Base>
<style>
  .lost {
    min-height: 70svh;
    align-content: center;
    row-gap: var(--space-m);
  }

  h1,
  p,
  a {
    grid-column: 1 / -1;
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.84;
  }

  p {
    font-size: var(--step-1);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    width: fit-content;
    font-weight: 750;
  }
</style>
